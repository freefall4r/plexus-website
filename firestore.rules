rules_version = '2';
// Plexus Workshop — Firestore security rules.
//
// Every read and write in this app goes through the server (Firebase Admin SDK
// in Next.js API routes / server components). The Admin SDK bypasses these rules,
// so we deny ALL direct browser access. A leaked admin passcode or client token
// therefore cannot touch the database directly.
//
// Covers both features that share this project:
//   projects/{slug}            -> live builds + /plexusadmin   (server-only)
//   fabricationOrders/{id}     -> on-demand CNC/laser orders   (server-only)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
