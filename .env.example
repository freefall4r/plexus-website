# ── Plexus Workshop environment variables ──
# Copy to .env.local for local dev; add the same in Vercel → Project → Settings → Environment Variables.

# Meshy.ai (server-side only — powers the image→3D studio). Get a key at https://meshy.ai
MESHY_API_KEY=your_meshy_api_key_here
MESHY_ENABLE_PBR=true

# Light rate limit for the public 3D generator (per visitor)
CUSTOM_RATE_MAX=4
CUSTOM_RATE_WINDOW_HOURS=6

# ── Sanity (the product dashboard at /studio) ──
# Create a free project at https://www.sanity.io/manage, then paste its ID here.
# See SANITY-SETUP.md for the 2-minute walkthrough.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# ── Plexus Live (the /live builds + /plexusadmin dashboard) ──
# The admin passcode you type to unlock /plexusadmin on your phone.
PLEXUS_ADMIN_PASSCODE=
# Optional separate secret for signing the login session (defaults to the passcode).
PLEXUS_ADMIN_SECRET=

# Firebase (server-side only — powers live builds + photo storage).
# From Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on ONE line with literal \n for newlines, wrapped in quotes.
FIREBASE_PRIVATE_KEY=
# e.g. plexus-live.appspot.com (Firebase console → Storage)
FIREBASE_STORAGE_BUCKET=

# ── On-Demand Fabrication (the /fabrication CNC + laser feature) ──
# Optional: WhatsApp ping to you when a new fabrication order lands, via the
# Meta WhatsApp Cloud API (same Meta path as Content Studio's IG auto-posting).
# If any of these are blank the ping is skipped — the order still saves to
# Firestore and shows in /plexusadmin. Get these from Meta → WhatsApp → API setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Your number in international format, digits only (e.g. 962791792129).
WHATSAPP_NOTIFY_TO=
