# ── PLEXUS AMMAN environment variables ──
# Copy to .env.local for local dev; add the same in Vercel → Project → Settings → Environment Variables.

# Meshy.ai (server-side only — powers the image→3D studio). Get a key at https://meshy.ai
MESHY_API_KEY=your_meshy_api_key_here
MESHY_ENABLE_PBR=true

# Light rate limit for the public 3D generator (per visitor)
CUSTOM_RATE_MAX=4
CUSTOM_RATE_WINDOW_HOURS=6
